/*
 * 复制为 board_hal.c 后，按你的 e2 studio / FSP 配置替换下面的占位调用。
 * 不要与 board_hal_stub.c 同时加入工程。
 *
 * 典型 FSP 资源：
 * - GPT PWM ×2：左右电机
 * - GPT 输入捕获或外部中断：编码器
 * - ADC：8 路灰度
 * - GPT 输入捕获：超声波回波脉宽
 * - GPT PWM ×4：舵机
 * - SCI UART：Host(115200) + Voice(9600)
 * - 系统滴答：board_millis
 */

#include "board_hal.h"
#include "app_config.h"

