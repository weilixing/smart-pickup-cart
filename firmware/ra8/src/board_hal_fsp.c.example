uint32_t board_millis(void)
{
    /* return xTaskGetTickCount(); 或自增滴答 */
    return 0;
}

void board_delay_ms(uint32_t ms)
{
    (void)ms;
}

void board_motor_set_duty(int16_t left_duty, int16_t right_duty)
{
    (void)left_duty;
    (void)right_duty;
    /* 映射到 PWM 占空比与 DIR 引脚 */
}

int32_t board_encoder_left(void) { return 0; }
int32_t board_encoder_right(void) { return 0; }

void board_line_read(uint16_t out[8])
{
    for (int i = 0; i < 8; i++) {
        out[i] = 0;
    }
}

uint16_t board_ultrasonic_front_mm(void) { return 0xFFFF; }
uint16_t board_ultrasonic_left_mm(void) { return 0xFFFF; }
uint16_t board_ultrasonic_right_mm(void) { return 0xFFFF; }

void board_servo_set_deg(uint8_t joint, float angle_deg)
{
    (void)joint;
    (void)angle_deg;
    /* 1.5ms 中位，约 0.5~2.5ms 对应 0~180° */
}

void board_host_uart_write(const uint8_t *data, uint16_t len)
{
    (void)data;
    (void)len;
}

int board_host_uart_read(uint8_t *data, uint16_t max_len)
{
    (void)data;
    (void)max_len;
    return 0;
}

void board_voice_uart_write(const uint8_t *data, uint16_t len)
{
    (void)data;
    (void)len;
}
