<?xml version="1.0"?>
<!-- 尺寸与 docs/mechanical.md 保持一致，单位：米 / 千克 / 弧度 -->
<robot name="pickup_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="deck_x" value="0.20"/>
  <xacro:property name="deck_y" value="0.16"/>
  <xacro:property name="deck_z" value="0.005"/>
  <xacro:property name="deck_z_pos" value="0.045"/>
  <xacro:property name="wheel_radius" value="0.0425"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="track" value="0.17"/>
  <xacro:property name="wheelbase" value="0.13"/>
  <xacro:property name="lift_travel" value="0.05"/>

  <material name="deck_gray"><color rgba="0.35 0.37 0.40 1.0"/></material>
  <material name="wheel_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="lift_orange"><color rgba="0.85 0.45 0.10 1.0"/></material>
  <material name="lidar_dark"><color rgba="0.15 0.20 0.25 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${deck_z_pos}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${deck_x} ${deck_y} ${deck_z}"/></geometry>
      <material name="deck_gray"/>
    </visual>
    <collision>
      <geometry><box size="${deck_x} ${deck_y} ${deck_z}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.009" iyz="0" izz="0.014"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix x_sign y_sign">
    <joint name="${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_sign * wheelbase / 2} ${y_sign * track / 2} ${wheel_radius - deck_z_pos}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_sign="1"  y_sign="1"/>
  <xacro:wheel prefix="front_right" x_sign="1"  y_sign="-1"/>
  <xacro:wheel prefix="rear_left"   x_sign="-1" y_sign="1"/>
  <xacro:wheel prefix="rear_right"  x_sign="-1" y_sign="-1"/>

  <!-- 雷达：车头低位安装（钻入货架时必须低于 130mm 净空） -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="${deck_x / 2 - 0.02} 0 ${0.09 - deck_z_pos}" rpy="0 0 0"/>
  </joint>
  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="lidar_dark"/>
    </visual>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- 顶升平台：棱柱关节，行程 0~50mm；收回时台面为整车最高点（≤115mm） -->
  <joint name="lift_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="lift_plate"/>
    <origin xyz="-0.01 0 ${deck_z / 2 + 0.0625}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="${lift_travel}" effort="20" velocity="0.01"/>
  </joint>
  <link name="lift_plate">
    <visual>
      <geometry><box size="0.16 0.14 0.005"/></geometry>
      <material name="lift_orange"/>
    </visual>
    <collision>
      <geometry><box size="0.16 0.14 0.005"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0013"/>
    </inertial>
  </link>

  <!-- IMU 与相机坐标系：安装位置按实物微调 -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${deck_z / 2 + 0.01}" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${deck_x / 2 - 0.05} 0 ${0.15 - deck_z_pos}" rpy="0 0 0"/>
  </joint>
  <link name="camera_link"/>

</robot>
