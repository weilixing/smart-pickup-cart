<?xml version="1.0"?>
<!-- 底盘 + 四自由度舵机臂示意模型；尺寸可按实车微调 -->
<robot name="pickup_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="deck_x" value="0.20"/>
  <xacro:property name="deck_y" value="0.16"/>
  <xacro:property name="deck_z" value="0.005"/>
  <xacro:property name="deck_z_pos" value="0.045"/>
  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="track" value="0.15"/>
  <xacro:property name="wheelbase" value="0.12"/>

  <material name="deck_gray"><color rgba="0.35 0.37 0.40 1.0"/></material>
  <material name="wheel_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="arm_orange"><color rgba="0.85 0.45 0.10 1.0"/></material>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${deck_z_pos}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${deck_x} ${deck_y} ${deck_z}"/></geometry>
      <material name="deck_gray"/>
    </visual>
    <collision>
      <geometry><box size="${deck_x} ${deck_y} ${deck_z}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.012"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix x_sign y_sign">
    <joint name="${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_sign * wheelbase / 2} ${y_sign * track / 2} ${wheel_radius - deck_z_pos}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <inertial>
        <mass value="0.06"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_sign="1"  y_sign="1"/>
  <xacro:wheel prefix="front_right" x_sign="1"  y_sign="-1"/>
  <xacro:wheel prefix="rear_left"   x_sign="-1" y_sign="1"/>
  <xacro:wheel prefix="rear_right"  x_sign="-1" y_sign="-1"/>

  <!-- 四自由度臂：底座 / 肩 / 肘 / 夹爪 -->
  <joint name="base_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="arm_base"/>
    <origin xyz="0.04 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="1.5"/>
  </joint>
  <link name="arm_base">
    <visual>
      <geometry><cylinder radius="0.02" length="0.03"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="arm_base"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="5" velocity="1.5"/>
  </joint>
  <link name="upper_arm">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.10 0.02 0.02"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="5" velocity="1.5"/>
  </joint>
  <link name="forearm">
    <visual>
      <origin xyz="0.04 0 0"/>
      <geometry><box size="0.08 0.018 0.018"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <inertial>
      <mass value="0.06"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gripper_joint" type="revolute">
    <parent link="forearm"/>
    <child link="gripper"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.0" effort="2" velocity="2.0"/>
  </joint>
  <link name="gripper">
    <visual>
      <geometry><box size="0.03 0.04 0.015"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <inertial>
      <mass value="0.04"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

</robot>
